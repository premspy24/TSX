# ===== TicketSwapX Environment Variables =====
# Copy this file to .env.local and fill in your values.
# All variables with `next_public_*` are safe to expose to the client.

# --- Database (PostgreSQL) ---
# Required for production. Use your managed Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/ticketswapx

# --- JWT Authentication ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY=7d

# --- OAuth: Google Login ---
# Create credentials at: https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OTP / SMS ---
# For phone OTP verification (e.g. Twilio, MSG91, etc.)
OTP_SERVICE_API_KEY=
OTP_SENDER_ID=

# --- Payments: Razorpay ---
# Create keys at: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payments: Stripe (alternative) ---
# Create keys at: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- File Storage (AWS S3 or S3-compatible) ---
# For ticket uploads (QR codes, PDFs, images)
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1

# --- Notifications ---
# Email: SendGrid or similar
SENDGRID_API_KEY=
EMAIL_FROM=tickets@ticketswapx.com

# Push: Firebase Cloud Messaging
FCM_SERVER_KEY=
FCM_VAPID_PUBLIC_KEY=

# --- Platform Settings ---
PLATFORM_FEE_PERCENT=10
NEXT_PUBLIC_APP_URL=http://localhost:3000